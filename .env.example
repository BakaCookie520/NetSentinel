# Backups live under NETSENTINEL_DATA_DIR/backups (Compose persists /app/data).
NETSENTINEL_BACKUP_UPLOAD_MAX_BYTES=1073741824
NETSENTINEL_BACKUP_EXPANDED_MAX_BYTES=10737418240
NETSENTINEL_RESTORE_DRAIN_TIMEOUT_MS=600000
NETSENTINEL_IMAGE=ghcr.nju.edu.cn/bakacookie520/netsentinel:latest
NETSENTINEL_HTTP_PORT=8080
COOKIE_SECURE=false
TRUST_PROXY=false

# Fresh installations choose SQLite or an external database in the setup wizard.
# SQLite, installation settings and generated master key persist under /app/data.
# Existing installations must retain their original master key and database.
# NETSENTINEL_MASTER_KEY=<existing-base64-key>
# DATABASE_URL=postgresql://user:password@host:5432/netsentinel
# WEB_ORIGIN=https://monitor.example.com
# REDIS_URL=redis://legacy-queue-host:6379
