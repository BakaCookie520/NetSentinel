POSTGRES_PASSWORD=replace-with-a-long-database-password
NETSENTINEL_MASTER_KEY=replace-with-output-of-openssl-rand-base64-32
# Backups live under NETSENTINEL_DATA_DIR/backups (Compose persists /app/data).
NETSENTINEL_BACKUP_UPLOAD_MAX_BYTES=1073741824
NETSENTINEL_BACKUP_EXPANDED_MAX_BYTES=10737418240
NETSENTINEL_RESTORE_DRAIN_TIMEOUT_MS=600000
NETSENTINEL_IMAGE=ghcr.nju.edu.cn/bakacookie520/netsentinel:latest
INITIAL_ADMIN_EMAIL=admin@netsentinel.local
INITIAL_ADMIN_PASSWORD=replace-with-at-least-12-characters
WEB_ORIGIN=http://localhost:8080
