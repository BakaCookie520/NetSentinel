{
  "name": "@netsentinel/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": { "ws": "^8.18.3" },
  "devDependencies": { "@types/node": "^22.18.3", "@types/ws": "^8.18.1", "tsx": "^4.20.5", "typescript": "^5.9.2", "vitest": "^3.2.4" }
}
